<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_sp_order_warning" model="ir.model.access">
    <field name="name">access.sp.order.warning</field>
    <field name="model_id" ref="model_sp_order_warning"/>
    <field name="group_id" ref="base.group_user"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    </record>
    <record id="sp_order_warning_form_view" model="ir.ui.view">
        <field name="name">sp.order.warning.form</field>
        <field name="model">sp.order.warning</field>
        <field name="arch" type="xml">
            <form string='Warning: open orders exist'>
                <div class='alert alert-warning' role='alert'>
                        <strong>Warning:</strong> this product already has
                    purchase orders that are not fully received. Ordering
                    again may cause overstock or exceed the budget.
                </div>
                <group>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="pending_qty"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                    </group>
                </group>
                <field name="order_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="date_order"/>
                        <field name="state"/>
                        <field name="amount_total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Create Anyway" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>